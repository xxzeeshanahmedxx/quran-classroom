{
  "name": "quran-classroom",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 execute quran-classroom-db --file=db/schema.sql",
    "db:seed": "wrangler d1 execute quran-classroom-db --file=db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/react": "^6.0.1",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-astro": "^0.556.0",
    "lucide-react": "^1.26.0",
    "prismjs": "^1.30.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "shadcn": "^4.14.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.107.0"
  }
}
