---
export interface Props {
  label: string;
  action: string;
  error?: string;
}

const { label, action, error } = Astro.props;
---

<div class="flex flex-col items-center gap-4">
  <input
    type="password"
    name="pin"
    inputmode="numeric"
    pattern="[0-9]*"
    maxlength="4"
    autocomplete="off"
    aria-label="PIN"
    class="h-10 w-24 rounded-lg border border-hairline px-3 py-2 text-center text-2xl font-mono tracking-[0.5em] text-ink"
    id="pinInput"
  />
  <div class="grid grid-cols-3 gap-2">
    {[1,2,3,4,5,6,7,8,9].map(n => (
      <button type="button" data-pad={n}
        class="h-12 w-16 rounded-lg border border-hairline bg-canvas text-lg font-medium text-ink hover:bg-surface-soft active:bg-surface-strong"
      >{n}</button>
    ))}
    <button type="button" data-pad="clear"
      class="h-12 w-16 rounded-lg border border-hairline bg-canvas text-sm text-muted-foreground hover:bg-surface-soft"
    >Clear</button>
    <button type="button" data-pad={0}
      class="h-12 w-16 rounded-lg border border-hairline bg-canvas text-lg font-medium text-ink hover:bg-surface-soft active:bg-surface-strong"
    >0</button>
    <button type="button" data-pad="back"
      class="h-12 w-16 rounded-lg border border-hairline bg-canvas text-sm text-muted-foreground hover:bg-surface-soft"
    >←</button>
  </div>
  {error && <p class="text-sm text-error">{error}</p>}
  <button type="submit" class="h-10 w-full rounded-lg bg-primary px-5 text-sm font-semibold text-on-primary hover:bg-primary-active hover-btn">
    {label}
  </button>
</div>

<script>
  const input = document.getElementById('pinInput') as HTMLInputElement;
  document.querySelectorAll('[data-pad]').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = btn.getAttribute('data-pad');
      if (val === 'clear') { input.value = ''; return; }
      if (val === 'back') { input.value = input.value.slice(0, -1); return; }
      if (input.value.length < 4) input.value += val;
    });
  });
</script>
