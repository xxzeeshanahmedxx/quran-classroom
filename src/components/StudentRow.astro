---
export interface Props {
  id: number;
  name: string;
  title: string;
  pin: string;
}

const { id, name, title, pin } = Astro.props;
---

<div class="flex items-center justify-between gap-4 rounded-xl bg-surface-card p-5 cursor-pointer hover-card">
  <div class="flex flex-col gap-0.5">
    <span class="title-sm text-ink">{name}</span>
    <span class="caption text-body">{title}</span>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <span class="font-mono text-sm text-muted-foreground">{pin}</span>
    <button
      type="button"
      class="h-8 rounded-lg border border-hairline bg-canvas px-3 caption font-semibold text-error leading-8 hover:bg-surface-soft hover-btn"
      data-delete-student={id}
    >
      Remove
    </button>
  </div>
</div>
