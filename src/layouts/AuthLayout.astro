---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Login to Live Quran Academy — live online Quran classes for kids and adults." />
    <title>{title} | Live Quran Academy</title>
  </head>
  <body class="flex min-h-screen items-center justify-center px-4 dark">
    <main>
      <div class="auth-card w-full max-w-sm rounded-xl p-8">
        <div class="mb-6 text-center">
          <h1 class="text-sm font-semibold text-ink">Live Quran Academy</h1>
          <p class="mt-1 text-sm text-muted-foreground">{title}</p>
        </div>
        <slot />
      </div>
    </main>
  </body>
</html>
