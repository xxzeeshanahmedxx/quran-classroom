---
import '../styles/global.css';
import { Toaster } from '../components/ui/sonner';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Live Quran Academy — live online Quran classes for kids and adults. Small groups, experienced teachers, personal attention at livequran.academy." />
    <title>{title} | Live Quran Academy</title>
  </head>
  <body class="min-h-screen font-sans text-body">
    <header class="sticky top-0 z-50 border-b border-hairline bg-surface-card">
      <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="text-sm font-semibold text-ink hover-link">Live Quran Academy</a>
        <nav class="flex items-center gap-4 text-sm">
          {user && (
            <>
              <span class="text-muted-foreground">{user.name}</span>
              <a href="/logout" class="text-muted-foreground hover-link" aria-label="Logout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16 17 21 12 16 7"/>
                  <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
              </a>
            </>
          )}
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-4xl px-4 py-6 sm:py-10">
      <div class="page-card rounded-xl p-6">
        <slot />
      </div>
    </main>
    <Toaster client:load />
  </body>
</html>
