---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | Live Quran Academy</title>
    <meta name="description" content="Page not found — let's get you back to learning." />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🕌</text></svg>" />
  </head>
  <body class="min-h-screen font-sans text-body bg-canvas">
    <header class="border-b border-hairline bg-canvas/95 backdrop-blur-sm">
      <div class="mx-auto flex h-16 max-w-5xl items-center px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-ink hover-link">
          <img src="/logo.webp" alt="" class="h-8 w-auto" />
          <span class="font-serif text-base font-bold text-ink">Live Quran Academy</span>
        </a>
      </div>
    </header>

    <main class="flex min-h-[70vh] flex-col items-center justify-center px-4 text-center">
      <span class="font-serif text-8xl font-bold text-primary sm:text-9xl">404</span>
      <p class="mt-4 max-w-md text-lg text-body sm:text-xl">
        Page not found — but your Quran journey is still waiting.
      </p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row">
        <a href="/" class="h-11 rounded-lg bg-primary px-6 text-sm font-semibold text-on-primary leading-11 hover:bg-primary-dark hover-btn">Back to Home</a>
        <a href="/#plans" class="h-11 rounded-lg border border-primary px-6 text-sm font-semibold text-primary leading-11 hover:bg-primary hover:text-on-primary hover-btn">See Plans</a>
      </div>
    </main>

    <footer class="border-t border-hairline bg-surface-card">
      <div class="mx-auto max-w-5xl px-4 py-8 text-center">
        <p class="text-sm text-muted-foreground">&copy; 2026 Live Quran Academy &middot; Lahore, Punjab, Pakistan</p>
      </div>
    </footer>
  </body>
</html>
