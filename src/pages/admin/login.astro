---
import AuthLayout from '../../layouts/AuthLayout.astro';
import ClickSparkForm from '../../components/ClickSparkForm';
import { authenticateAdmin, createSession } from '../../lib/auth';

if (Astro.locals.user?.type === 'admin') {
  return Astro.redirect('/admin/dashboard');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password') as string;
  const user = authenticateAdmin(Astro, password);
  if (!user) {
    return Astro.redirect('/admin/login?error=invalid');
  }
  createSession(Astro, user);
  return Astro.redirect('/admin/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<AuthLayout title="Admin Login">
  <ClickSparkForm client:load>
    <form method="POST" action="/admin/login" class="flex flex-col gap-4">
      <input type="password" name="password" placeholder="Admin password"
        class="h-10 rounded-lg border border-hairline bg-canvas px-3.5 py-2.5 text-sm text-ink placeholder:text-muted-foreground" />
      {error === 'invalid' && <p class="text-sm text-error">Wrong password</p>}
      <button type="submit"
        class="h-10 rounded-lg bg-primary px-5 text-sm font-semibold text-on-primary hover:bg-primary-active hover-btn">
        Log In
      </button>
    </form>
  </ClickSparkForm>
</AuthLayout>
