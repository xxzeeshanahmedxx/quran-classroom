---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroActions from '../components/HeroActions';
import { Check, ChevronDown, Star, BookOpen, Clock, ShieldCheck } from 'lucide-astro';
---

<BaseLayout title="Home" wide>
  <!-- 1. Hero -->
  <section class="py-16 sm:py-24">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-center">
      <div class="sm:w-3/5">
        <h1 class="display-xl text-ink">Give Your Child the Gift of Quran</h1>
        <p class="mt-4 max-w-lg body-md text-body">
          Proper tajweed from the comfort of home. Learn directly with <strong class="text-ink">Asif Zubair</strong> — 
          a certified teacher with 10+ years of experience and 100+ students. Choose Nazra or Hifz, 
          and start with a <strong class="text-ink">3-day free trial</strong>.
        </p>
        <HeroActions client:load />
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full border border-hairline bg-surface-card px-3 py-1 text-xs text-muted">10+ Years Experience</span>
          <span class="rounded-full border border-hairline bg-surface-card px-3 py-1 text-xs text-muted">100+ Students Taught</span>
          <span class="rounded-full border border-hairline bg-surface-card px-3 py-1 text-xs text-muted">3-Day Free Trial</span>
          <span class="rounded-full border border-hairline bg-surface-card px-3 py-1 text-xs text-muted">Max 3 per Class</span>
        </div>
        <p class="mt-4 text-sm text-muted">
          Or <a href="https://wa.me/923001234567?text=I'm%20interested%20in%20Quran%20classes%20for%20my%20child" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover-link">WhatsApp us</a> — we'll answer within the hour, inshaAllah.
        </p>
      </div>
      <div class="sm:w-2/5">
        <img
          src="https://placehold.co/600x500/1B6B4A/FFFFFF?text=Online+Quran+Classes"
          alt="Child learning Quran online"
          class="w-full rounded-xl shadow-cal-elevated"
          width="600"
          height="500"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. Teacher -->
  <section class="bg-surface-soft py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">Meet Your Teacher</h2>
      <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start">
        <img
          src="https://placehold.co/400x400/1B6B4A/FFFFFF?text=Asif+Zubair"
          alt="Asif Zubair — Quran teacher"
          class="h-48 w-48 rounded-xl object-cover shadow-cal-elevated sm:h-56 sm:w-56"
          width="224"
          height="224"
          loading="lazy"
        />
        <div class="max-w-xl">
          <h3 class="title-sm text-ink">Asif Zubair</h3>
          <p class="caption text-muted">Certified Quran Teacher — Islamabad, Pakistan</p>
          <p class="mt-3 body-sm text-body">
            With over 10 years of experience teaching children and adults, Asif Zubair has helped 
            100+ students read the Quran with proper tajweed and confidence. Every class is taught 
            by Asif personally — not an assistant, not a substitute. He is background-checked, 
            patient, and passionate about Quran education.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              <Check size={12} /> Certified Tajweed Teacher
            </span>
            <span class="flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              <Check size={12} /> 10+ Years Experience
            </span>
            <span class="flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              <Check size={12} /> Background Checked
            </span>
            <span class="flex items-center gap-1 rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              <Check size={12} /> 100+ Students Taught
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Plans -->
  <section id="plans" class="py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">Choose Your Plan</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        <!-- Nazra card — Most Popular -->
        <div class="relative rounded-xl bg-surface-card p-8 shadow-cal-elevated">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gold px-4 py-1 text-xs font-semibold text-on-gold">Most Popular</span>
          <h3 class="mt-2 text-center font-serif text-xl font-bold text-ink">Nazra (Full Quran)</h3>
          <p class="mt-1 text-center text-sm text-muted">Read the entire Quran with proper tajweed</p>
          <div class="mt-4 flex items-baseline justify-center gap-2">
            <span class="price-old">7,000 PKR</span>
            <span class="font-serif text-3xl font-bold text-ink">4,699 PKR</span>
            <span class="text-sm text-muted">/mo</span>
          </div>
          <p class="mt-1 text-center text-sm font-medium text-primary">Save 2,301 PKR &middot; 3-day free trial</p>
          <ul class="mt-6 flex flex-col gap-2 text-sm text-body">
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> 30-min live classes</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Full Quran recitation with tajweed</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Max 3 students per class</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Learn from home</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Cancel anytime</li>
          </ul>
          <a href="/learn/login" class="mt-6 block h-11 rounded-lg bg-primary text-center text-sm font-semibold text-on-primary leading-11 hover:bg-primary-dark hover-btn">Start Free Trial</a>
        </div>
        <!-- Hifz card -->
        <div class="rounded-xl bg-surface-card p-8 shadow-cal-elevated">
          <h3 class="mt-2 text-center font-serif text-xl font-bold text-ink">Hifz (30th Para)</h3>
          <p class="mt-1 text-center text-sm text-muted">Memorize Juz 30 with correct pronunciation</p>
          <div class="mt-4 flex items-baseline justify-center gap-2">
            <span class="price-old">10,000 PKR</span>
            <span class="font-serif text-3xl font-bold text-ink">7,499 PKR</span>
            <span class="text-sm text-muted">/mo</span>
          </div>
          <p class="mt-1 text-center text-sm font-medium text-primary">Save 2,501 PKR &middot; 3-day free trial</p>
          <ul class="mt-6 flex flex-col gap-2 text-sm text-body">
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> 30-min live classes</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Memorize Juz 30 with fluency</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Max 3 students per class</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Learn from home</li>
            <li class="flex items-center gap-2"><Check size={14} class="shrink-0 text-primary" /> Cancel anytime</li>
          </ul>
          <a href="/learn/login" class="mt-6 block h-11 rounded-lg border border-primary text-center text-sm font-semibold text-primary leading-11 hover:bg-primary hover:text-on-primary hover-btn">Start Free Trial</a>
        </div>
      </div>
      <!-- Complimentary note -->
      <p class="mt-8 text-center text-sm text-muted">
        Both plans include <strong class="text-ink">complimentary</strong> subjects at no extra cost:
      </p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        <span class="rounded-full bg-surface-card px-4 py-1.5 text-xs text-ink">Noorani Qaida</span>
        <span class="rounded-full bg-surface-card px-4 py-1.5 text-xs text-ink">Complete Salah</span>
        <span class="rounded-full bg-surface-card px-4 py-1.5 text-xs text-ink">6 Kalimas</span>
        <span class="rounded-full bg-surface-card px-4 py-1.5 text-xs text-ink">Daily Duas</span>
        <span class="rounded-full bg-surface-card px-4 py-1.5 text-xs text-ink">Basic Islamic Knowledge</span>
      </div>
    </div>
  </section>

  <!-- 4. Testimonials -->
  <section class="bg-surface-soft py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">What Parents Are Saying</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl bg-surface-card p-6 shadow-cal-subtle">
          <div class="flex gap-0.5 text-gold">
            <Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" />
          </div>
          <p class="mt-3 text-sm text-body leading-relaxed">"My son looks forward to his Quran class every day. Asif sahab is incredibly patient and makes learning fun."</p>
          <p class="mt-3 text-xs font-medium text-ink">— Ahmed R., Rawalpindi</p>
        </div>
        <div class="rounded-xl bg-surface-card p-6 shadow-cal-subtle">
          <div class="flex gap-0.5 text-gold">
            <Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" />
          </div>
          <p class="mt-3 text-sm text-body leading-relaxed">"We tried 3 different academies before finding this one. The small class size makes a huge difference."</p>
          <p class="mt-3 text-xs font-medium text-ink">— Fatima K., Islamabad</p>
        </div>
        <div class="rounded-xl bg-surface-card p-6 shadow-cal-subtle">
          <div class="flex gap-0.5 text-gold">
            <Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" /><Star size={16} fill="#d4a843" />
          </div>
          <p class="mt-3 text-sm text-body leading-relaxed">"Alhamdulillah, my daughter completed Noorani Qaida in just 2 months. Highly recommend!"</p>
          <p class="mt-3 text-xs font-medium text-ink">— Sarah M., Lahore</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Why Families Choose Us -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">Why Families Choose Us</h2>
      <div class="grid gap-4 sm:grid-cols-4">
        <div class="rounded-xl bg-surface-card p-5 hover-card">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary">
            <Check size={18} strokeWidth={2.5} />
          </div>
          <h3 class="mt-3 text-sm font-semibold text-ink">Qualified &amp; Trusted</h3>
          <p class="mt-1 text-xs text-body">10+ years experience, background-checked, certified teacher.</p>
        </div>
        <div class="rounded-xl bg-surface-card p-5 hover-card">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary">
            <Clock size={18} strokeWidth={2} />
          </div>
          <h3 class="mt-3 text-sm font-semibold text-ink">Fits Your Schedule</h3>
          <p class="mt-1 text-xs text-body">Pick slots around school and work. Morning or evening — your choice.</p>
        </div>
        <div class="rounded-xl bg-surface-card p-5 hover-card">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary">
            <BookOpen size={18} strokeWidth={2} />
          </div>
          <h3 class="mt-3 text-sm font-semibold text-ink">Complete Curriculum</h3>
          <p class="mt-1 text-xs text-body">Nazra or Hifz + Noorani Qaida, Salah, 6 Kalimas, Duas, and more.</p>
        </div>
        <div class="rounded-xl bg-surface-card p-5 hover-card">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-on-primary">
            <ShieldCheck size={18} strokeWidth={2} />
          </div>
          <h3 class="mt-3 text-sm font-semibold text-ink">Safe &amp; Islamic Environment</h3>
          <p class="mt-1 text-xs text-body">Classes follow Islamic etiquette. Gender-separated options for older students.</p>
        </div>
      </div>
      <!-- Mini testimonial beneath -->
      <div class="mt-8 rounded-xl border border-hairline bg-surface-card p-5 text-center">
        <p class="text-sm text-body italic">"My daughter improved her tajweed in just 2 months. Asif sahab is very patient and kind."</p>
        <p class="mt-2 text-xs font-medium text-ink">— Fatima, Islamabad</p>
      </div>
    </div>
  </section>

  <!-- 6. How It Works -->
  <section class="bg-surface-soft py-16 sm:py-20">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">How It Works</h2>
      <div class="flex flex-col gap-6">
        <div class="relative flex items-start gap-5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">1</div>
          <div class="rounded-xl bg-surface-card p-5 flex-1 hover-card">
            <h3 class="text-sm font-semibold text-ink">Sign Up</h3>
            <p class="mt-1 text-sm text-body">Sign up with your phone number. Quick and simple — takes less than a minute.</p>
          </div>
        </div>
        <div class="relative flex items-start gap-5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">2</div>
          <div class="rounded-xl bg-surface-card p-5 flex-1 hover-card">
            <h3 class="text-sm font-semibold text-ink">Choose Your Schedule</h3>
            <p class="mt-1 text-sm text-body">Pick available time slots that work for you. Morning or evening — your choice.</p>
          </div>
        </div>
        <div class="relative flex items-start gap-5">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-on-primary">3</div>
          <div class="rounded-xl bg-surface-card p-5 flex-1 hover-card">
            <h3 class="text-sm font-semibold text-ink">Start Learning</h3>
            <p class="mt-1 text-sm text-body">Join live 30-minute video classes from home with Asif Zubair. All you need is a phone or laptop.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="mb-10 text-center display-md text-ink">Frequently Asked Questions</h2>
      <div class="flex flex-col gap-2">
        <details class="group rounded-xl bg-surface-card p-4 [&[open]_svg]:rotate-180">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink">
            What will my child learn?
            <ChevronDown size={16} strokeWidth={2} class="shrink-0 transition-transform duration-200" />
          </summary>
          <p class="mt-2 text-sm text-body">
            You choose between <strong class="text-ink">Nazra (Full Quran)</strong> — reading the entire Quran with proper tajweed, or <strong class="text-ink">Hifz (30th Para)</strong> — memorizing Juz 30. Both include complimentary subjects at no extra cost: Noorani Qaida, Complete Salah, 6 Kalimas, Daily Duas, and Basic Islamic Knowledge.
          </p>
        </details>
        <details class="group rounded-xl bg-surface-card p-4 [&[open]_svg]:rotate-180">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink">
            Who teaches the classes?
            <ChevronDown size={16} strokeWidth={2} class="shrink-0 transition-transform duration-200" />
          </summary>
          <p class="mt-2 text-sm text-body">All classes are taught by <strong class="text-ink">Asif Zubair</strong> — a certified Quran teacher with over 10 years of experience and 100+ students taught. He specializes in teaching children and beginners.</p>
        </details>
        <details class="group rounded-xl bg-surface-card p-4 [&[open]_svg]:rotate-180">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink">
            What ages do you teach?
            <ChevronDown size={16} strokeWidth={2} class="shrink-0 transition-transform duration-200" />
          </summary>
          <p class="mt-2 text-sm text-body">Children ages 5 and up, as well as adults. Students are grouped by skill level so everyone learns at the right pace.</p>
        </details>
        <details class="group rounded-xl bg-surface-card p-4 [&[open]_svg]:rotate-180">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink">
            What do I need to start?
            <ChevronDown size={16} strokeWidth={2} class="shrink-0 transition-transform duration-200" />
          </summary>
          <p class="mt-2 text-sm text-body">Just a phone, tablet, or laptop with internet. Classes run in your browser — no software to install.</p>
        </details>
        <details class="group rounded-xl bg-surface-card p-4 [&[open]_svg]:rotate-180">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-ink">
            How much does it cost?
            <ChevronDown size={16} strokeWidth={2} class="shrink-0 transition-transform duration-200" />
          </summary>
          <p class="mt-2 text-sm text-body">
            <strong class="text-ink">Nazra (Full Quran):</strong> <span class="price-old">7,000 PKR</span> → 4,699 PKR/month.<br />
            <strong class="text-ink">Hifz (30th Para):</strong> <span class="price-old">10,000 PKR</span> → 7,499 PKR/month.<br />
            Both include a <strong class="text-ink">3-day free trial</strong> — no commitment, no credit card. Contact us to enroll.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Contact -->
  <section id="contact" class="bg-surface-soft py-16 sm:py-20">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="display-md text-ink">Get in Touch</h2>
      <p class="mt-3 text-sm text-body">Prefer to talk first? Send us a WhatsApp message and we'll answer within the hour, inshaAllah.</p>
      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center sm:gap-6">
        <a href="https://wa.me/923001234567?text=I'm%20interested%20in%20Quran%20classes%20for%20my%20child" target="_blank" rel="noopener noreferrer" class="flex h-11 items-center gap-2 rounded-lg bg-[#25D366] px-6 text-sm font-semibold text-white hover:bg-[#1da851] hover-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
        <span class="text-sm text-muted">or call +92 300 1234567</span>
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted">
        <span>info@livequran.academy</span>
        <span>Islamabad, Pakistan</span>
      </div>
    </div>
  </section>

  <!-- 9. Final CTA -->
  <section class="relative bg-primary py-16 sm:py-20 geometric-overlay">
    <div class="relative mx-auto max-w-2xl px-4 text-center">
      <h2 class="font-serif text-3xl font-bold text-on-primary sm:text-4xl">Give Your Child the Quran They Deserve</h2>
      <p class="mt-3 text-sm text-on-primary/80 max-w-md mx-auto">Join 100+ families who trust Live Quran Academy. Start your 3-day free trial today — no credit card, no commitment.</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4">
        <a href="/learn/login" class="h-11 rounded-lg bg-gold px-6 text-sm font-semibold text-on-gold leading-11 hover:bg-gold-light hover-btn">Start Free Trial</a>
        <a href="https://wa.me/923001234567?text=I'm%20interested%20in%20Quran%20classes%20for%20my%20child" target="_blank" rel="noopener noreferrer" class="h-11 rounded-lg border border-on-primary/30 px-6 text-sm font-semibold text-on-primary leading-11 hover:bg-on-primary/10 hover-btn">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>