---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroActions from '../components/HeroActions';
---

<BaseLayout title="Home">
  <div class="flex flex-col items-center py-24 text-center">
    <h1 class="display-xl text-ink">Live Quran Academy</h1>
    <p class="mt-4 max-w-md body-md text-body">
      Live online Quran classes for kids and adults. Small groups,
      experienced teachers, personal attention — all at livequran.academy.
    </p>
    <HeroActions client:load />
  </div>
</BaseLayout>
