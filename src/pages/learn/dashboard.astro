---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb, getTeacherById, getSlotsByTeacherDate } from '../../lib/db';

if (!Astro.locals.user || Astro.locals.user.type !== 'student') {
  return Astro.redirect('/learn/login');
}

const db = getDb(Astro);
const { id: studentId, name, teacherId = 1 } = Astro.locals.user;
const now = new Date();
const todayStr = now.toISOString().slice(0, 10);

const [slots, teacher] = await Promise.all([
  getSlotsByTeacherDate(db, teacherId, todayStr),
  getTeacherById(db, teacherId),
]);

function fmt12h(time24: string): string {
  const [h, m] = time24.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 || 12;
  return `${h12}:${m.toString().padStart(2, '0')} ${period}`;
}

const mySlot = slots.find(slot => {
  const ids: number[] = JSON.parse(slot.student_ids);
  return ids.includes(studentId);
});

const isNow = mySlot ? (() => {
  const [h, m] = mySlot.time.split(':').map(Number);
  const slotStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m);
  const slotEnd = new Date(slotStart.getTime() + 30 * 60 * 1000);
  return now >= slotStart && now <= slotEnd;
})() : false;
---

<BaseLayout title="My Class">
  <div class="flex flex-col items-center py-16">
    <h2 class="body-md text-muted-foreground">Assalamu Alaikum</h2>
    <h1 class="mt-1 display-sm text-ink">{name}</h1>

    {mySlot ? (
      <div class="mt-8 flex w-full max-w-sm flex-col items-center gap-6 rounded-xl border border-hairline bg-surface-card p-8 text-center hover-card">
        <p class="body-sm text-muted-foreground">
          Your next class with
          <span class="font-semibold text-ink">{teacher?.name ?? 'your teacher'}</span>
        </p>
        <span class="display-sm text-ink">{fmt12h(mySlot.time)}</span>
        {isNow ? (
          <a href={`/learn/room/${mySlot.id}`}
            class="h-10 w-full rounded-lg bg-primary px-5 text-sm font-semibold text-on-primary text-center leading-10 hover:bg-primary-active hover-btn"
          >Join Class</a>
        ) : (
          <span class="body-sm text-muted-foreground">Come back at your scheduled time</span>
        )}
      </div>
    ) : (
      <div class="mt-8 py-16 text-center">
        <p class="body-md text-muted-foreground">No class scheduled for today</p>
      </div>
    )}
  </div>
</BaseLayout>
