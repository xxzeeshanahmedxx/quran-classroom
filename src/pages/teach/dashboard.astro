---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb, getStudentsByTeacher, getSlotsByTeacherDate } from '../../lib/db';
import AddSlotDialog from '../../components/AddSlotDialog';
import SlotCards from '../../components/SlotCards';
import { todayPK, fmtDatePK } from '../../lib/utils';

if (!Astro.locals.user) {
  return Astro.redirect('/teach/login?error=session');
}
if (Astro.locals.user.type !== 'teacher') {
  return Astro.redirect('/teach/login');
}

const db = await getDb(Astro);
const todayStr = todayPK();
const teacherId = 1;

const [slots, students] = await Promise.all([
  getSlotsByTeacherDate(db, teacherId, todayStr),
  getStudentsByTeacher(db, teacherId),
]);
---

<BaseLayout title="Dashboard">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h2 class="title-lg text-ink">Today's Schedule</h2>
      <p class="caption text-muted-foreground">{fmtDatePK(todayStr)}</p>
    </div>
    <div class="flex gap-3">
      <a href="/teach/students"
        class="h-10 rounded-lg border border-hairline bg-canvas px-5 text-sm font-semibold text-ink leading-10 hover:bg-surface-soft hover-btn"
      >Manage Students</a>
      <AddSlotDialog client:load />
    </div>
  </div>

  <SlotCards client:load slots={slots} students={students.map(s => ({ id: s.id, name: s.name, title: s.title }))} todayStr={todayStr} />
</BaseLayout>
