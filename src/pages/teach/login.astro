---
import AuthLayout from '../../layouts/AuthLayout.astro';
import PinPad from '../../components/PinPad.astro';
import ClickSparkForm from '../../components/ClickSparkForm';
import { authenticateTeacher, createSession } from '../../lib/auth';

if (Astro.locals.user?.type === 'teacher') {
  return Astro.redirect('/teach/dashboard');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const pin = formData.get('pin') as string;
  const user = await authenticateTeacher(Astro, pin);
  if (!user) {
    return Astro.redirect('/teach/login?error=invalid');
  }
  createSession(Astro, user);
  return Astro.redirect('/teach/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<AuthLayout title="Teacher Login">
  <ClickSparkForm client:load>
    <form method="POST" action="/teach/login" class="flex flex-col items-center gap-4">
      <PinPad label="Log In" action="/teach/login" error={error === 'invalid' ? 'Wrong PIN' : undefined} />
    </form>
  </ClickSparkForm>
</AuthLayout>
