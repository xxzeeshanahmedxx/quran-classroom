---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDb } from '../../../lib/db';
import { createDailyRoom, createDailyToken } from '../../../lib/daily';
import { getEnv } from '../../../lib/env';
import { getSchoolConfig } from '../../../lib/config';
import { todayPK } from '../../../lib/utils';

if (!Astro.locals.user) {
  return Astro.redirect('/teach/login?error=session');
}
if (Astro.locals.user.type !== 'teacher') {
  return Astro.redirect('/teach/login');
}

const { id } = Astro.params;
const db = await getDb(Astro);
const slot = await db.prepare('SELECT * FROM slots WHERE id = ?').bind(Number(id)).first<any>();

function fmt12h(time24: string): string {
  const [h, m] = time24.split(':').map(Number);
  const period = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 || 12;
  return `${h12}:${m.toString().padStart(2, '0')} ${period}`;
}

if (!slot) return Astro.redirect('/teach/dashboard');

let roomUrl = '';
let errorMsg = '';
const apiKey = getEnv(Astro, 'DAILY_API_KEY');
const config = getSchoolConfig(Astro);

if (!slot.room_name) {
  const roomName = `quran-${slot.teacher_id}-${slot.date}-${slot.time.replace(':', '')}`;
  try {
    const [hSl, mSl] = slot.time.split(':').map(Number);
    const slotDate = new Date(todayPK() + 'T' + slot.time);
    const now = new Date();
    const remainingSec = Math.max(30 * 60, Math.floor((slotDate.getTime() + 30 * 60 * 1000 - now.getTime()) / 1000));
    const baseUrl = await createDailyRoom(apiKey, roomName, Math.ceil(remainingSec / 60));
    // Create owner token so teacher can mute/unmute students
    const token = await createDailyToken(apiKey, roomName, config.teacherName, true);
    roomUrl = `${baseUrl}?t=${token}`;
    await db.prepare("UPDATE slots SET room_name = ?, status = 'active' WHERE id = ?")
      .bind(roomName, Number(id)).run();
  } catch (e: any) {
    errorMsg = e.message || 'Failed to create classroom. Check Daily.co API key.';
  }
} else {
  roomUrl = `https://${slot.room_name}.daily.co/${slot.room_name}`;
}
---

<BaseLayout title="Classroom">
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <h2 class="title-sm text-ink">Classroom — {fmt12h(slot.time)}</h2>
      <a href="/teach/dashboard" class="body-sm text-muted-foreground hover:text-ink">← Back</a>
    </div>
    {errorMsg ? (
      <div class="rounded-xl border border-error/30 bg-error/5 p-8 text-center">
        <p class="text-error font-semibold">Could not create classroom</p>
        <p class="mt-2 text-sm text-body">{errorMsg}</p>
        <a href="/teach/dashboard" class="mt-4 inline-block h-10 rounded-lg bg-primary px-5 text-sm font-semibold text-on-primary leading-10 hover:bg-primary-dark">Back to Dashboard</a>
      </div>
    ) : (
      <div class="aspect-video rounded-xl border border-hairline bg-surface-soft">
        <iframe
          src={roomUrl}
          class="h-full w-full rounded-lg"
          allow="camera; microphone; fullscreen"
        ></iframe>
      </div>
    )}
  </div>
</BaseLayout>
