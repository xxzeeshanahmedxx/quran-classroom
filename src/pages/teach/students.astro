---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddStudentDialog from '../../components/AddStudentDialog';
import StudentCards from '../../components/StudentCards';
import { getDb, getStudentsByTeacher, getTeacherById } from '../../lib/db';

if (!Astro.locals.user) {
  return Astro.redirect('/teach/login?error=session');
}
if (Astro.locals.user.type !== 'teacher') {
  return Astro.redirect('/teach/login');
}

const db = await getDb(Astro);
const [students, teacher] = await Promise.all([
  getStudentsByTeacher(db, 1),
  getTeacherById(db, 1),
]);
const error = Astro.url.searchParams.get('error');
const errorMsg = error === 'max_students' ? 'Max 20 students reached' : error === 'invalid_title' ? 'Invalid title' : error === 'invalid_gender' ? 'Invalid gender' : error === 'invalid_name' ? 'Name is required' : null;
---

<BaseLayout title="Students">
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h2 class="title-lg text-ink">Students</h2>
      <p class="caption text-muted-foreground">{teacher?.name ?? 'Teacher'}'s class</p>
    </div>
    <AddStudentDialog client:load />
  </div>

  {errorMsg && <p class="mb-4 text-sm text-error">{errorMsg}</p>}

  <StudentCards client:load students={students.map(s => ({ id: s.id, name: s.name, title: s.title, gender: s.gender, pin: s.pin }))} teacherName={teacher?.name ?? 'Teacher'} />
</BaseLayout>
